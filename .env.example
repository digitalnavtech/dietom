# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
#
# This file lists PUBLIC variables only (NEXT_PUBLIC_* are bundled into the
# browser code). Server-only secrets such as DATABASE_URL are described in
# README.md → "Environment variables" and must never use the NEXT_PUBLIC_ prefix.

# Public base URL of this deployment, used for canonical URLs, sitemap and Open Graph.
# Leave unset locally (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API (or the "Connect" dialog).
# URL looks like https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The PUBLISHABLE key (sb_publishable_...). Never the secret / service_role key:
# the app refuses to start if a secret key is put here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
